# Copy to .env and adjust. The React app uses NONE of these values.
CRIMEMAP_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/crimemap
CRIMEMAP_DEFAULT_RANGE_FROM=2026-04-01
CRIMEMAP_DEFAULT_RANGE_TO=2026-10-08
# Server-only key for the assistant proxy (never exposed to the browser).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
