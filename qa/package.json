{
  "name": "crimemap-qa",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated test workspace for CRIMEMAP (root project is untouched)",
  "type": "module",
  "scripts": {
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:load": "echo \"locust -f load/locustfile.py --host http://localhost:5173\"",
    "test": "vitest run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}